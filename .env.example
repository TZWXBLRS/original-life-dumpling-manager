# 环境变量示例 - 复制为 .env.local 后修改

# 数据库
DATABASE_URL="file:./data/dumpling.db"

# NextAuth (Auth.js)
NEXTAUTH_SECRET="your-secret-key-here-change-in-production-please-use-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# 管理员初始账号（首次启动 seed 时使用）
ADMIN_NAME="管理员"
ADMIN_PHONE="13800138000"
ADMIN_PASSWORD="admin123"
