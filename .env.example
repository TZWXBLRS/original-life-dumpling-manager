# ==========================================================
# 本地开发环境（SQLite 文件存储，无需 Turso 账号）
# ==========================================================
DATABASE_URL="file:./prisma/data/dumpling.db"
NEXTAUTH_SECRET="本地开发用-改成长字符串32位以上-请勿用于生产"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_PHONE="15313659956"
ADMIN_PASSWORD="sushenghuo107"

# ==========================================================
# 短信验证码（可选能力，不配也能用）
# 不配置 → 顾客输入手机号直接一键登录，线上不受影响
# 配置后 → 顾客登录时自动出现验证码输入框，必须验证才能登录
# 两种接入方式任选其一，下面的变量留空即视为「未配置」
# ==========================================================
#
# 方式 A：阿里云短信（需先在阿里云控制台申请签名与模板）
# SMS_ACCESS_KEY_ID="LTAI..."
# SMS_ACCESS_KEY_SECRET="..."
# SMS_SIGN_NAME="原味生活"
# SMS_TEMPLATE_CODE="SMS_123456789"
#
# 方式 B：自建 / 第三方短信网关（我们会以 POST {phone, code} 的 JSON 调用它）
# SMS_PROVIDER_URL="https://your-sms-gateway.example.com/send"

# ==========================================================
# 生产环境 Cloudflare Pages + Turso 配置
# 部署时把这些值用 wrangler 写入 secrets，不要写到这里
# wrangler secret put TURSO_DATABASE_URL
# wrangler secret put TURSO_AUTH_TOKEN
# wrangler secret put NEXTAUTH_SECRET
# wrangler secret put ADMIN_PASSWORD
#
# 启用短信验证码时追加（按上面方式 A 或 B 二选一）：
# wrangler secret put SMS_ACCESS_KEY_ID
# wrangler secret put SMS_ACCESS_KEY_SECRET
# wrangler secret put SMS_SIGN_NAME
# wrangler secret put SMS_TEMPLATE_CODE
#   —— 或 ——
# wrangler secret put SMS_PROVIDER_URL
# ==========================================================
# TURSO_DATABASE_URL="libsql://dumpling-shop-你的用户名.turso.io"
# TURSO_AUTH_TOKEN="eyJhbGciOi...（turso db tokens create 输出的字符串）"
# NEXTAUTH_URL="https://dumpling-shop.pages.dev"
